%% NockLock — Package Architecture
%% Package dependencies as of v0.6.1 (from `go list` imports).
%% cli is the only package that wires fences together; fence packages do not import each other, except
%% landlock → fs and netns → network (sub-packages of their parent fence).

graph TD
    main["cmd/nocklock<br/>Entry point"] --> cli

    subgraph "internal/cli — cobra commands"
        cli["wrap · init · doctor · validate · config<br/>scan · verify · anchor · log · status · version<br/>egress-probe · __netns-helper"]
    end

    subgraph "internal/fence"
        fs["fence/fs<br/>Linux LD_PRELOAD interposer + event socket<br/>macOS Seatbelt (SBPL) profile"]
        landlock["fence/fs/landlock<br/>Landlock ruleset (Linux)"]
        sys["fence/syscallfence<br/>seccomp denylist + socket families (Linux)"]
        net["fence/network<br/>allowlist HTTP/HTTPS proxy, CONNECT tunnel"]
        netns["fence/network/netns<br/>netns helper, nftables default-drop,<br/>tproxy + DNS sidecars (Linux, opt-in)"]
        sec["fence/secrets<br/>env pass/block filter + preflight scan"]
    end

    config["internal/config<br/>strict TOML, security-first defaults"]
    logging["internal/logging<br/>SQLite audit log: hash chain,<br/>Ed25519 signatures, chain head, anchors"]
    forward["internal/forward<br/>opt-in async delivery to Command ops log"]
    anchorclient["internal/anchorclient<br/>push / fetch off-box chain-head anchors"]
    version["internal/version"]
    receipt["pkg/receipt<br/>public read-only VerifySession"]

    cli --> config
    cli --> fs
    cli --> landlock
    cli --> sys
    cli --> net
    cli --> netns
    cli --> sec
    cli --> logging
    cli --> forward
    cli --> anchorclient
    cli --> version

    fs --> config
    landlock --> fs
    netns --> net
    net --> config
    net --> logging
    logging --> config
    forward --> logging
    anchorclient --> logging
    receipt --> logging

    receipt -.->|"imported by"| nockguard["NockGuard<br/>verify --session"]

    classDef external stroke-dasharray: 5 5
    class nockguard external
