%% NockLock — Event Flow
%% Fence decisions → signed hash chain → chain-head anchor → verify.
%% Command forwarding is opt-in and never changes local rows.

flowchart LR
    subgraph "Fences (inside wrap)"
        FS["Filesystem<br/>deny ~/.ssh/id_rsa"]
        NET["Network / egress<br/>allow github.com:443<br/>deny evil.example:443"]
        SEC["Secrets<br/>blocked AWS_SECRET_ACCESS_KEY (name only)"]
        SYS["Syscall<br/>fence state"]
    end

    subgraph "Local audit log (outside the project)"
        ROW["Row N<br/>event fields + prev_hash<br/>hash = SHA-256(row, prev)<br/>Ed25519 signature"]
        HEAD["Chain head<br/>last hash + row count, signed"]
        ANCH["chain-anchor.json<br/>written at teardown"]
        ROW -->|"prev_hash links to row N-1"| ROW
        ROW --> HEAD --> ANCH
    end

    FS --> ROW
    NET --> ROW
    SEC --> ROW
    SYS --> ROW

    KEY["~/.config/nocklock/signing-ed25519.key"] -. signs .-> ROW
    KEY -. signs .-> HEAD

    ANCH -->|"NOCKLOCK_ANCHOR_URL set<br/>5s, fail-open"| OFF["Off-box anchor<br/>(e.g. NockCC)"]
    ROW -->|"[audit.forward] enabled<br/>bounded async queue"| CMD["Command ops log<br/>POST /api/brain/ops-log/<br/>session id + entry hash"]

    ROW --> LOG["nocklock log<br/>filter by type / action / time"]
    ROW --> VER["nocklock verify --audit<br/>re-hash, check signatures,<br/>compare head with anchor"]
    ANCH --> VER
    OFF -. "--anchor" .-> VER
    ROW --> RCPT["pkg/receipt.VerifySession<br/>(used by NockGuard)"]

    classDef optional stroke-dasharray: 5 5
    class OFF,CMD optional
